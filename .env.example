DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mydb
TEST_DB_NAME=test_db
LOG_LEVEL=INFO
LOG_ENV=development
ADMIN_API_KEY=uma-chave-bem-grande-aqui
APP_GEO_SECRET=uma-chave-bem-grande-aqui
GEO_SIGNATURE_MAX_SKEW_SECONDS=60

# Redis (opcional — se não configurado, usa in-memory; não funciona com múltiplos workers)
# REDIS_URL=redis://localhost:6379

# CORS — origens permitidas (JSON array). ["*"] apenas para desenvolvimento.
# Em produção, liste as origens explícitas: '["https://app.exemplo.com"]'
CORS_ALLOWED_ORIGINS=["*"]