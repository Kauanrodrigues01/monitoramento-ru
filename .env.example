# =============================================================================
# Database
# =============================================================================

# Local: localhost | Docker Compose: db (definido automaticamente)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mydb

# Banco utilizado nos testes automatizados
TEST_DB_NAME=test_db

# =============================================================================
# Application
# =============================================================================

# Nunca utilize True em produção
DEBUG=True

# development | staging | production
LOG_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Security
# =============================================================================

# Chave para autenticação de rotas administrativas — gere um valor aleatório seguro
ADMIN_API_KEY=change-me

# Chave para assinatura de requisições de geolocalização — gere um valor aleatório seguro
APP_GEO_SECRET=change-me

# Janela de validade da assinatura geográfica em segundos (padrão: 60)
GEO_SIGNATURE_MAX_SKEW_SECONDS=60

# =============================================================================
# CORS
# =============================================================================

# Desenvolvimento: ["*"] | Produção: ["https://app.exemplo.com"]
CORS_ALLOWED_ORIGINS=["*"]

# =============================================================================
# Redis
# =============================================================================

# Local: redis://localhost:6379/0 | Docker Compose: redis://redis:6379/0 (definido automaticamente)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# RabbitMQ
# =============================================================================

# Credenciais do broker — use valores seguros em produção
# Em Docker Compose Dev as credencias são fixas como admin:admin independentemente do .env, para facilitar o desenvolvimento
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin

# Local: amqp://usuario:senha@localhost:5672/
# Docker Compose: definido automaticamente pelos arquivos compose, não precisa ser setado no .env para dev ou prod
CELERY_BROKER_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@localhost:5672/
